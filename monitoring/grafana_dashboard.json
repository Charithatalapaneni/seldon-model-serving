  "panels": [
    {
      "title": "Prediction Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(model_serving_prediction_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(model_serving_prediction_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(model_serving_prediction_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Request Rate (by model)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(model_serving_requests_total[5m])) by (model_type)",
          "legendFormat": "{{model_type}}"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(model_serving_errors_total[5m])) by (model_type)",
          "legendFormat": "{{model_type}} errors"
        }
      ]
    },
    {
      "title": "Active Requests",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "model_serving_active_requests",
          "legendFormat": "active"
        }
      ]
    },
    {
      "title": "Models Loaded",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {
          "expr": "model_serving_models_loaded",
          "legendFormat": "loaded"
        }
      ]
    }
  ],
